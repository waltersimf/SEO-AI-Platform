// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("free")
  maxProjects Int      @default(5)
  
  users        User[]
  integrations Integration[]  // ← ДОДАЙ ЦЕЙ РЯДОК
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chats        Chat[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  role           String   @default("seo") // admin, seo, account_manager
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chatMembers  ChatMember[]
  messages     Message[]

  @@map("users")
}

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       String   // "google", "ahrefs", "serpstat"
  accessToken    String   @db.Text
  refreshToken   String?  @db.Text
  tokenExpiry    DateTime?
  scopes         String[] // ["https://www.googleapis.com/auth/webmasters.readonly"]
  
  metadata       Json?    // { email: "user@gmail.com", connectedAt: "..." }
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([organizationId, provider])
  @@map("integrations")
}
model Chat {
  id             String   @id @default(cuid())
  name           String?
  type           String   @default("group") // "direct" | "group"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members        ChatMember[]
  messages       Message[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("chats")
}

model ChatMember {
  id     String @id @default(cuid())
  userId String
  chatId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([userId, chatId])
  @@map("chat_members")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  
  createdAt DateTime @default(now())
  
  @@index([chatId, createdAt])
  @@map("messages")
}