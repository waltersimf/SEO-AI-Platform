// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("free")
  maxProjects Int      @default(5)
  
  users        User[]
  integrations Integration[]  // ← ДОДАЙ ЦЕЙ РЯДОК
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  role           String   @default("seo") // admin, seo, account_manager
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       String   // "google", "ahrefs", "serpstat"
  accessToken    String   @db.Text
  refreshToken   String?  @db.Text
  tokenExpiry    DateTime?
  scopes         String[] // ["https://www.googleapis.com/auth/webmasters.readonly"]
  
  metadata       Json?    // { email: "user@gmail.com", connectedAt: "..." }
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([organizationId, provider])
  @@map("integrations")
}