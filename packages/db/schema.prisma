// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organization Role Enum
enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Task Management Enums
enum TaskStatus {
  pending_acceptance
  backlog
  scheduled
  todo
  in_progress
  blocked
  paused
  done
  declined
  wont_do
}

enum TaskPriority {
  low
  medium
  high
  critical
}

model Organization {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  plan        String @default("free")
  maxProjects Int    @default(5)

  users            User[]
  integrations     Integration[]
  projects         Project[]
  tasks            Task[]
  autoPlanSettings AutoPlanSettings?
  invites          Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats Chat[]

  @@map("organizations")
}

model Project {
  id     String @id @default(cuid())
  name   String
  domain String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  targetKeywords String[]
  competitors    String[]

  gscPropertyUrl String? // GSC property URL
  gaPropertyId   String? // GA4 property ID

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("projects")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  avatar       String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobRole String @default("seo") // admin, seo, account_manager, ai_assistant
  role    Role   @default(MEMBER) // Organization role: OWNER, ADMIN, MEMBER, VIEWER

  isAI       Boolean   @default(false)
  aiModel    String?
  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatMembers ChatMember[]
  messages    Message[]

  // Task Management relations
  assignedTasks Task[]        @relation("AssignedTasks")
  createdTasks  Task[]        @relation("CreatedTasks")
  taskComments  Comment[]
  timeEntries   TimeEntry[]
  settings      UserSettings?

  // Invite relations
  sentInvites Invite[]

  @@map("users")
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider     String // "google", "ahrefs", "serpstat"
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?
  scopes       String[] // ["https://www.googleapis.com/auth/webmasters.readonly"]

  metadata Json? // { email: "user@gmail.com", connectedAt: "..." }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider])
  @@map("integrations")
}

model Chat {
  id             String       @id @default(cuid())
  name           String?
  type           String       @default("group") // "direct" | "group"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members  ChatMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")
}

model ChatMember {
  id     String @id @default(cuid())
  userId String
  chatId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([userId, chatId])
  @@map("chat_members")
}

model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  isAIResponse Boolean @default(false)
  aiContext    Json?
  aiModel      String?

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@map("messages")
}

// Task Management Models
model Task {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  status   TaskStatus   @default(backlog)
  priority TaskPriority @default(medium)

  // Relations
  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Scheduling
  scheduledDate DateTime?
  scheduledTime String?   // Time in HH:MM format (e.g., "11:00", "14:30")
  dueDate       DateTime?

  // Time tracking
  estimatedTime Float? // Hours
  actualTime    Float? // Hours

  // Tags
  tags String[]

  // Acceptance workflow
  acceptedAt    DateTime?
  declinedAt    DateTime?
  declineReason String?

  // Group tasks
  groupTaskId String? // Shared ID to link grouped tasks, no relation
  isGroupTask Boolean @default(false)

  // Recurring tasks
  isRecurring      Boolean   @default(false)
  recurrenceRule   String?   // "daily", "weekly", "monthly"
  recurrenceEnd    DateTime? // When the recurrence should stop
  parentTaskId     String?
  parentTask       Task?     @relation("RecurringTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks       Task[]    @relation("RecurringTasks")

  // Timestamps
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Related models
  comments    Comment[]
  timeEntries TimeEntry[]

  @@index([assignedToId, status])
  @@index([status])
  @@index([assignedToId])
  @@index([scheduledDate])
  @@index([projectId])
  @@index([organizationId])
  @@map("tasks")
}

model Comment {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model TimeEntry {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime?
  duration  Float? // Duration in minutes

  note String?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@map("time_entries")
}

model UserSettings {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workingHoursPerDay  Float   @default(8)
  workingDays         Int[]   @default([1, 2, 3, 4, 5]) // 0=Sunday, 1=Monday, etc.
  bufferTime          Float   @default(0.5) // Hours between tasks
  timeTrackingEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model AutoPlanSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled   Boolean @default(false)
  frequency String  @default("weekly") // "daily", "weekly"
  dayOfWeek Int     @default(1) // 0=Sunday, 1=Monday, etc.
  time      String  @default("08:00") // HH:MM format

  notifyBeforeApply Boolean @default(true) // Send preview to chat first
  autoApply         Boolean @default(false) // Apply automatically without confirmation

  lastRunAt DateTime? // Track when auto-plan last ran
  nextRunAt DateTime? // Track when auto-plan should run next

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auto_plan_settings")
}

// Invite Model for organization invitations
model Invite {
  id    String @id @default(cuid())
  email String
  token String @unique
  role  Role   @default(MEMBER)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@index([organizationId])
  @@map("invites")
}
